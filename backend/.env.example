# Copy to .env for local development. Never commit the real .env.
# Every variable here is validated at boot by src/config/env.ts — a missing or
# malformed value fails the process start rather than the first request that needs it.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --- Database -------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=footprint
POSTGRES_PASSWORD=footprint
POSTGRES_DB=footprint_review
DATABASE_SSL=false
DATABASE_LOGGING=false
DATABASE_POOL_SIZE=10

# Apply pending migrations on startup. Convenient for local and single-instance
# deploys; set to false where migrations are run as a separate deploy step.
RUN_MIGRATIONS_ON_BOOT=true

# --- HTTP -----------------------------------------------------------------------
# Comma-separated allowlist. An explicit list, never a wildcard with credentials.
CORS_ORIGINS=http://localhost:3000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_READS=300
RATE_LIMIT_MAX_WRITES=60

# Number of trusted proxies in front of the app. Leave at 0 when there is none:
# trusting a proxy that is not there lets a client spoof its IP via X-Forwarded-For
# and evade the rate limiter.
TRUST_PROXY_HOPS=0

# --- Seed -----------------------------------------------------------------------
# Password given to every demo account by `npm run seed`. Read only by the seed, which
# refuses to run with NODE_ENV=production — nothing else in the app looks at it.
SEED_PASSWORD=Password123!
