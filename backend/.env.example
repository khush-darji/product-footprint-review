# Copy to .env for local development. Never commit the real .env.
#
# Every variable here is validated at boot by src/config/env.ts, and there are NO
# defaults: a missing or malformed value fails the process start rather than the first
# request that needs it. Everything below is required unless marked optional, so this
# file is the complete list — if the app boots, the config is fully specified.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --- Database -------------------------------------------------------------------
# Optional. Supply a full connection URL and the five POSTGRES_* variables below are
# not needed; omit it and they are required, because they are what the URL is built
# from. A hosted database usually hands you the URL and nothing else.
# DATABASE_URL=postgres://user:password@host:5432/dbname

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=footprint
POSTGRES_PASSWORD=footprint
POSTGRES_DB=footprint_review

DATABASE_SSL=false
DATABASE_LOGGING=false
DATABASE_POOL_SIZE=10

# Apply pending migrations on startup. Convenient for local and single-instance
# deploys; set to false where migrations are run as a separate deploy step.
RUN_MIGRATIONS_ON_BOOT=true

# --- HTTP -----------------------------------------------------------------------
# Comma-separated allowlist. An explicit list, never a wildcard with credentials.
CORS_ORIGINS=http://localhost:3000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_READS=300
RATE_LIMIT_MAX_WRITES=60
# Login is where brute force lives, so it gets a much tighter budget than writes.
RATE_LIMIT_MAX_LOGINS=20

# Number of trusted proxies in front of the app. Leave at 0 when there is none:
# trusting a proxy that is not there lets a client spoof its IP via X-Forwarded-For
# and evade the rate limiter.
TRUST_PROXY_HOPS=0

# SameSite policy for the session cookie: lax, strict or none. "none" is only honoured
# over HTTPS, so it is rejected at boot unless NODE_ENV=production — a browser would
# otherwise drop the cookie silently and signing in would appear to do nothing.
COOKIE_SAME_SITE=lax

# --- Seed -----------------------------------------------------------------------
# Optional. Password given to every demo account by `npm run seed`. Read only by the
# seed, which refuses to run with NODE_ENV=production — nothing else looks at it, so an
# unset value fails the seed rather than stopping the app from booting.
SEED_PASSWORD=Password123!
