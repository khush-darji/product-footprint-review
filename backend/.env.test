# Test environment. Points at a scratch database so a test run can never touch dev data.
#
# There are no defaults in src/config/env.ts, so every required variable has to be here
# even where the value does not matter to a test — the suite boots the real config.

NODE_ENV=test
PORT=4000
LOG_LEVEL=silent

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=footprint
POSTGRES_PASSWORD=footprint
POSTGRES_DB=footprint_review_test

DATABASE_SSL=false
DATABASE_LOGGING=false
DATABASE_POOL_SIZE=10
# The suite runs migrations itself in global-setup, once, rather than per worker.
RUN_MIGRATIONS_ON_BOOT=false

CORS_ORIGINS=http://localhost:3000

# Deliberately far above anything the suite generates. The rate limiter is keyed on IP
# and every test shares one, so production-sized budgets would turn an ordinary run into
# a stream of 429s and make failures depend on test ordering.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_READS=100000
RATE_LIMIT_MAX_WRITES=100000
RATE_LIMIT_MAX_LOGINS=100000

TRUST_PROXY_HOPS=0
COOKIE_SAME_SITE=lax
